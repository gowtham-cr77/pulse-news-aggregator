# PULSE Environment Configuration
APP_NAME=PULSE
APP_ENV=development

# Database URL: defaults to local SQLite for zero-config startup.
# For PostgreSQL (recommended for production / Docker):
# DATABASE_URL=postgresql+psycopg://pulse:pulse_password@localhost:5432/pulse
DATABASE_URL=sqlite:///./pulse.db

# Security: change this in production!
JWT_SECRET_KEY=change-this-to-a-long-random-secret-key-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# Ingestion scheduler
INGESTION_INTERVAL_MINUTES=30
INGEST_ON_STARTUP=true
FEED_FETCH_TIMEOUT_SECONDS=15

# Optional free-tier Indian News JSON API keys (works out-of-the-box without these via live Indian RSS feeds)
GNEWS_API_KEY=
NEWSDATA_API_KEY=

# CORS origins (comma-separated)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Default seeded demo accounts (override or disable in production)
SEED_DEMO_DATA=true
DEMO_ADMIN_EMAIL=admin@pulse.org
DEMO_ADMIN_PASSWORD=Admin@123
DEMO_READER_EMAIL=reader@pulse.org
DEMO_READER_PASSWORD=Reader@123
